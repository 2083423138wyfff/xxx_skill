{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/xxx-skill/schemas/intake_question_set.schema.json",
  "title": "IntakeQuestionSet",
  "type": "object",
  "required": [
    "required_question_ids",
    "must_confirm_question_ids",
    "conditional_question_ids",
    "default_notice_ids",
    "answered_question_ids",
    "pending_question_ids"
  ],
  "properties": {
    "required_question_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/question_id" },
      "uniqueItems": true
    },
    "must_confirm_question_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/question_id" },
      "uniqueItems": true
    },
    "conditional_question_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/question_id" },
      "uniqueItems": true
    },
    "default_notice_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/question_id" },
      "uniqueItems": true
    },
    "answered_question_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/question_id" },
      "uniqueItems": true
    },
    "pending_question_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/question_id" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "question_id": {
      "type": "string",
      "enum": [
        "project_title",
        "research_theme",
        "reference_materials_status",
        "content_template_source",
        "template_family_selection",
        "funding_program",
        "target_length",
        "output_formats",
        "docx_required",
        "docx_format_template_source",
        "builtin_docx_format_approval",
        "web_search_permission",
        "human_review_setting",
        "image_generation_policy",
        "attachment_policy",
        "table_policy",
        "source_reuse_mode",
        "source_segment_selection",
        "team_basis_reuse_confirmation",
        "current_team_identity",
        "deadline_or_delivery_time",
        "missing_info_policy"
      ]
    }
  },
  "additionalProperties": false
}
