{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/xxx-skill/schemas/task_config.schema.json",
  "title": "TaskConfig",
  "type": "object",
  "required": [
    "artifact",
    "project_title",
    "reference_materials",
    "template",
    "capability_snapshot",
    "research_scope",
    "output_formats",
    "human_review",
    "target_length",
    "intake_question_set",
    "source_reuse",
    "outline_gate"
  ],
  "properties": {
    "artifact": { "$ref": "./artifact.schema.json" },
    "project_title": { "type": "string", "minLength": 1 },
    "reference_materials": { "type": "array", "items": { "type": "string" } },
    "content_template_ref": { "type": ["string", "null"] },
    "docx_format_template_ref": { "type": ["string", "null"] },
    "template": {
      "type": "object",
      "required": ["source", "template_type"],
      "properties": {
        "source": { "type": "string", "enum": ["user_provided", "built_in", "mixed", "unresolved"] },
        "template_type": {
          "type": "string",
          "enum": [
            "basic_research",
            "mission_rnd",
            "social_science",
            "industry_rnd",
            "platform_construction",
            "compact_proposal",
            "user_template",
            "unresolved"
          ]
        }
      },
      "additionalProperties": false
    },
    "research_scope": { "type": "string", "enum": ["web_search", "academic_db"] },
    "capability_snapshot": { "$ref": "./capability_snapshot.schema.json" },
    "file_capability_report_ref": { "type": ["string", "null"] },
    "source_segment_registry_ref": { "type": ["string", "null"] },
    "source_segment_assembly_plan_ref": { "type": ["string", "null"] },
    "output_formats": {
      "type": "array",
      "items": { "type": "string", "enum": ["markdown", "json", "docx"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "human_review": {
      "type": "object",
      "required": ["enabled", "gates"],
      "properties": {
        "enabled": { "type": "boolean" },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["post_intake", "degradation_confirm", "post_template", "post_outline", "post_audit"]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "target_length": {
      "type": "object",
      "required": ["words", "pages", "use_template_default", "raw_user_answer"],
      "properties": {
        "words": { "type": ["integer", "null"], "minimum": 1 },
        "pages": { "type": ["integer", "null"], "minimum": 1 },
        "use_template_default": { "type": "boolean" },
        "raw_user_answer": { "type": ["string", "null"] }
      },
      "anyOf": [
        { "required": ["words"], "properties": { "words": { "type": "integer" } } },
        { "required": ["pages"], "properties": { "pages": { "type": "integer" } } },
        { "required": ["use_template_default"], "properties": { "use_template_default": { "const": true } } }
      ],
      "additionalProperties": false
    },
    "funding_program": { "type": ["string", "null"] },
    "deadline_or_delivery_time": { "type": ["string", "null"] },
    "docx_format_decision_state": {
      "type": "object",
      "required": ["docx_required", "source", "user_approved_builtin_template", "pending_questions"],
      "properties": {
        "docx_required": { "type": "boolean" },
        "source": { "type": "string", "enum": ["user_template", "builtin_template", "manual_user_answers", "unresolved"] },
        "user_approved_builtin_template": { "type": "boolean" },
        "pending_questions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "image_generation_policy": {
      "type": "object",
      "required": ["actual_image_generation", "output_mode"],
      "properties": {
        "actual_image_generation": { "type": "boolean", "const": false },
        "output_mode": { "type": "string", "enum": ["figure_prompts_or_mermaid_only"] }
      },
      "additionalProperties": false
    },
    "attachment_policy": {
      "type": "object",
      "required": ["source", "missing_behavior"],
      "properties": {
        "source": { "type": "string", "enum": ["user_provided_only"] },
        "missing_behavior": { "type": "string", "enum": ["leave_blank"] }
      },
      "additionalProperties": false
    },
    "table_policy": {
      "type": "object",
      "required": ["source", "missing_behavior"],
      "properties": {
        "source": { "type": "string", "enum": ["user_template_and_user_data_only"] },
        "missing_behavior": { "type": "string", "enum": ["leave_blank_or_placeholder"] }
      },
      "additionalProperties": false
    },
    "source_reuse": {
      "type": "object",
      "required": [
        "mode",
        "old_proposal_present",
        "multi_topic_materials_present",
        "selected_segment_refs",
        "team_basis_reuse_confirmation",
        "forbidden_old_context_defaults"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "old_proposal_rewrite", "multi_source_segment_assembly", "unresolved"]
        },
        "old_proposal_present": { "type": "boolean" },
        "multi_topic_materials_present": { "type": "boolean" },
        "selected_segment_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_ref", "location_hint", "resolved_segment_id"],
            "properties": {
              "source_ref": { "type": "string" },
              "location_hint": { "type": "string" },
              "resolved_segment_id": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "team_basis_reuse_confirmation": {
          "type": "string",
          "enum": ["confirmed_same_team", "confirmed_user_authorized", "not_allowed", "unresolved"]
        },
        "forbidden_old_context_defaults": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "old_project_title",
              "old_application_type",
              "old_research_object",
              "old_application_scenario",
              "old_budget",
              "old_indicators",
              "old_partners",
              "old_period",
              "old_management_arrangements",
              "unrelated_old_technical_route"
            ]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "outline_gate": {
      "type": "object",
      "required": ["post_outline_required", "can_skip", "approved_outline_version"],
      "properties": {
        "post_outline_required": { "type": "boolean", "const": true },
        "can_skip": { "type": "boolean", "const": false },
        "approved_outline_version": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "missing_info_policy": { "type": ["string", "null"], "enum": ["placeholder_then_continue", "stop_and_wait", null] },
    "intake_question_set": { "$ref": "./intake_question_set.schema.json" },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
