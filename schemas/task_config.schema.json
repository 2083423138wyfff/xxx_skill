{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/xxx-skill/schemas/task_config.schema.json",
  "title": "TaskConfig",
  "type": "object",
  "required": [
    "artifact",
    "project_title",
    "reference_materials",
    "template",
    "capability_snapshot",
    "research_scope",
    "output_formats",
    "human_review",
    "target_length",
    "intake_question_set"
  ],
  "properties": {
    "artifact": { "$ref": "./artifact.schema.json" },
    "project_title": { "type": "string", "minLength": 1 },
    "reference_materials": { "type": "array", "items": { "type": "string" } },
    "template": {
      "type": "object",
      "required": ["source", "template_type"],
      "properties": {
        "source": { "type": "string", "enum": ["user_provided", "built_in", "mixed", "unresolved"] },
        "template_type": {
          "type": "string",
          "enum": [
            "basic_research",
            "mission_rnd",
            "social_science",
            "industry_rnd",
            "platform_construction",
            "compact_proposal",
            "user_template",
            "unresolved"
          ]
        }
      },
      "additionalProperties": false
    },
    "research_scope": { "type": "string", "enum": ["web_search", "academic_db"] },
    "capability_snapshot": { "$ref": "./capability_snapshot.schema.json" },
    "output_formats": {
      "type": "array",
      "items": { "type": "string", "enum": ["markdown", "json", "docx"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "human_review": {
      "type": "object",
      "required": ["enabled", "gates"],
      "properties": {
        "enabled": { "type": "boolean" },
        "gates": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["post_intake", "degradation_confirm", "post_template", "post_outline", "post_audit"]
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "target_length": {
      "type": "object",
      "required": ["words", "pages", "use_template_default", "raw_user_answer"],
      "properties": {
        "words": { "type": ["integer", "null"], "minimum": 1 },
        "pages": { "type": ["integer", "null"], "minimum": 1 },
        "use_template_default": { "type": "boolean" },
        "raw_user_answer": { "type": ["string", "null"] }
      },
      "anyOf": [
        { "required": ["words"], "properties": { "words": { "type": "integer" } } },
        { "required": ["pages"], "properties": { "pages": { "type": "integer" } } },
        { "required": ["use_template_default"], "properties": { "use_template_default": { "const": true } } }
      ],
      "additionalProperties": false
    },
    "funding_program": { "type": ["string", "null"] },
    "deadline_or_delivery_time": { "type": ["string", "null"] },
    "missing_info_policy": { "type": ["string", "null"], "enum": ["placeholder_then_continue", "stop_and_wait", null] },
    "intake_question_set": { "$ref": "./intake_question_set.schema.json" },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
