{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/xxx-skill/schemas/figure_prompt_plan.schema.json",
  "title": "FigurePromptPlan",
  "type": "object",
  "required": [
    "artifact",
    "figure_prompts",
    "unresolved_placeholders",
    "assumptions",
    "change_log",
    "status"
  ],
  "properties": {
    "artifact": { "$ref": "./artifact.schema.json" },
    "figure_prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "figure_prompt_id",
          "placeholder_id",
          "section_id",
          "insertion_anchor",
          "output_type",
          "visual_type",
          "caption",
          "alt_text",
          "prompt_text",
          "mermaid_reference",
          "source_claim_ids",
          "source_refs",
          "assumptions",
          "forbidden_additions",
          "validation_status"
        ],
        "properties": {
          "figure_prompt_id": { "type": "string" },
          "placeholder_id": { "type": "string" },
          "section_id": { "type": "string" },
          "insertion_anchor": { "type": "string" },
          "output_type": { "type": "string", "enum": ["image_prompt", "mermaid_reference", "both"] },
          "visual_type": { "type": "string", "enum": ["workflow", "architecture", "timeline", "comparison", "mechanism", "data_chart_prompt", "other"] },
          "caption": { "type": "string" },
          "alt_text": { "type": "string" },
          "prompt_text": { "type": "string" },
          "mermaid_reference": { "type": ["string", "null"] },
          "source_claim_ids": { "type": "array", "items": { "type": "string" } },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "assumptions": { "type": "array", "items": { "type": "string" } },
          "forbidden_additions": { "type": "array", "items": { "type": "string" } },
          "validation_status": { "type": "string", "enum": ["valid", "needs_revision", "blocked"] }
        },
        "additionalProperties": false
      }
    },
    "unresolved_placeholders": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "change_log": { "type": "array", "items": { "type": "object" } },
    "status": { "type": "string", "enum": ["SUCCESS", "NEED_USER_INPUT", "NEED_REVISION", "BLOCKED", "FAILED"] }
  },
  "additionalProperties": false
}
