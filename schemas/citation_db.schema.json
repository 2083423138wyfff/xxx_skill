{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CitationDatabase",
  "type": "object",
  "required": [
    "pools",
    "references"
  ],
  "properties": {
    "pools": {
      "type": "object",
      "required": [
        "foreign",
        "domestic",
        "tech"
      ],
      "properties": {
        "foreign": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "count": {
              "type": "integer"
            }
          }
        },
        "domestic": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "count": {
              "type": "integer"
            }
          }
        },
        "tech": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            },
            "count": {
              "type": "integer"
            }
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref_id",
          "display_id",
          "pool",
          "direction_ids",
          "citation_gb7714"
        ],
        "properties": {
          "ref_id": {
            "type": "string"
          },
          "display_id": {
            "type": "integer"
          },
          "pool": {
            "type": "string",
            "enum": [
              "foreign",
              "domestic",
              "tech"
            ]
          },
          "direction_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "journal",
              "conference",
              "report",
              "patent",
              "standard",
              "book",
              "internal"
            ]
          },
          "authors": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "institution": {
            "type": "string"
          },
          "tech_highlight": {
            "type": "string"
          },
          "achievement_summary": {
            "type": "string"
          },
          "citation_gb7714": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "verification_needed": {
            "type": "boolean"
          },
          "industrialization": {
            "type": "string"
          },
          "trend": {
            "type": "string"
          }
        }
      }
    },
    "insufficient_directions": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "verification_needed_count": {
      "type": "integer"
    }
  }
}