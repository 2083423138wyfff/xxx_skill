{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParsedTemplate",
  "type": "object",
  "required": [
    "doc_type",
    "sections",
    "output_template"
  ],
  "properties": {
    "doc_type": {
      "type": "string",
      "enum": [
        "key_rnd_project",
        "nsfc_general",
        "nsfc_youth",
        "provincial_key",
        "enterprise_rnd"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "section_id",
          "title",
          "word_limit",
          "required_elements",
          "sub_directions"
        ],
        "properties": {
          "section_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "word_limit": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "required_elements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "paragraph_style": {
            "type": "string",
            "enum": [
              "per_direction",
              "chronological",
              "tech_domain"
            ]
          },
          "sub_directions": {
            "type": "integer",
            "minimum": 1
          },
          "special_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overall_route_required": {
            "type": "boolean"
          }
        }
      }
    },
    "output_template": {
      "type": "object",
      "required": [
        "heading_style",
        "font",
        "line_spacing",
        "citation_format"
      ],
      "properties": {
        "heading_style": {
          "type": "string",
          "enum": [
            "chinese_number",
            "arabic_number",
            "mixed"
          ]
        },
        "font": {
          "type": "string"
        },
        "line_spacing": {
          "type": "number"
        },
        "citation_format": {
          "type": "string",
          "enum": [
            "GB/T 7714-2015",
            "APA",
            "MLA"
          ]
        },
        "reference_list_position": {
          "type": "string",
          "enum": [
            "end_of_doc",
            "per_section"
          ]
        }
      }
    }
  }
}