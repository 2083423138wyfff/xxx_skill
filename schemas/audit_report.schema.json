{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuditReport",
  "type": "object",
  "required": [
    "overall_pass",
    "score",
    "dimensions",
    "iteration_needed"
  ],
  "properties": {
    "overall_pass": {
      "type": "boolean"
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "dimensions": {
      "type": "object",
      "required": [
        "citation",
        "academic",
        "format",
        "consistency"
      ],
      "properties": {
        "citation": {
          "type": "object",
          "required": [
            "pass",
            "score"
          ],
          "properties": {
            "pass": {
              "type": "boolean"
            },
            "score": {
              "type": "integer"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fix_commands": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "academic": {
          "type": "object",
          "required": [
            "pass",
            "score"
          ],
          "properties": {
            "pass": {
              "type": "boolean"
            },
            "score": {
              "type": "integer"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fix_commands": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "format": {
          "type": "object",
          "required": [
            "pass",
            "score"
          ],
          "properties": {
            "pass": {
              "type": "boolean"
            },
            "score": {
              "type": "integer"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fix_commands": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "consistency": {
          "type": "object",
          "required": [
            "pass",
            "score"
          ],
          "properties": {
            "pass": {
              "type": "boolean"
            },
            "score": {
              "type": "integer"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "fix_commands": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "iteration_needed": {
      "type": "boolean"
    },
    "target_agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high",
        "critical"
      ]
    },
    "unresolved_after_max_iter": {
      "type": "boolean"
    }
  }
}