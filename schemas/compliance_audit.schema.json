{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/xxx-skill/schemas/compliance_audit.schema.json",
  "title": "ComplianceAudit",
  "type": "object",
  "required": [
    "artifact",
    "overall_pass",
    "readiness",
    "fix_commands",
    "force_delivery_eligible",
    "blocking_reasons",
    "typography_issues",
    "layout_issues",
    "forbidden_markdown_style_found",
    "source_reuse_audit",
    "outline_gate_check",
    "audit_report_fields",
    "status"
  ],
  "properties": {
    "artifact": { "$ref": "./artifact.schema.json" },
    "overall_pass": { "type": "boolean" },
    "readiness": { "type": "string", "enum": ["draft", "reviewable", "ready_for_delivery", "blocked"] },
    "missing_sections": { "type": "array", "items": { "type": "string" } },
    "missing_elements": { "type": "array", "items": { "type": "string" } },
    "word_limit_issues": { "type": "array", "items": { "type": "object" } },
    "page_limit_issues": { "type": "array", "items": { "type": "object" } },
    "typography_issues": { "type": "array", "items": { "type": "object" } },
    "layout_issues": { "type": "array", "items": { "type": "object" } },
    "user_override_violations": { "type": "array", "items": { "type": "object" } },
    "logic_map_gaps": { "type": "array", "items": { "type": "object" } },
    "forbidden_content_found": { "type": "array", "items": { "type": "object" } },
    "forbidden_markdown_style_found": { "type": "array", "items": { "type": "object" } },
    "figure_prompt_issues": { "type": "array", "items": { "type": "object" } },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } },
    "fix_commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "target", "reason", "severity"],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "rerun_template_analyst",
              "rerun_reference_material_decomposer",
              "rerun_outline_architect",
              "rerun_section_writer",
              "rerun_figure_prompt_agent",
              "rerun_integrator",
              "rerun_literature_backfill",
              "rerun_citation_verifier",
              "rerun_ai_style_auditor",
              "ask_user",
              "block"
            ]
          },
          "target": { "type": "string" },
          "reason": { "type": "string" },
          "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] }
        },
        "additionalProperties": false
      }
    },
    "force_delivery_eligible": { "type": "boolean" },
    "blocking_reasons": { "type": "array", "items": { "type": "string" } },
    "source_reuse_audit": {
      "type": "object",
      "required": [
        "selected_segments_used",
        "forbidden_segments_found",
        "old_context_leakage",
        "team_basis_reuse_confirmed",
        "unresolved_reuse_risks"
      ],
      "properties": {
        "selected_segments_used": { "type": "array", "items": { "type": "string" } },
        "forbidden_segments_found": { "type": "array", "items": { "type": "object" } },
        "old_context_leakage": { "type": "array", "items": { "type": "object" } },
        "team_basis_reuse_confirmed": { "type": "boolean" },
        "unresolved_reuse_risks": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "outline_gate_check": {
      "type": "object",
      "required": [
        "post_outline_gate_present",
        "outline_state",
        "approved_outline_version",
        "approved_section_assignments_version",
        "approved_logic_map_version",
        "writing_started_after_approval"
      ],
      "properties": {
        "post_outline_gate_present": { "type": "boolean" },
        "outline_state": { "type": "string", "enum": ["DRAFT", "PENDING_USER_REVIEW", "APPROVED_LOCKED", "REVISION_REQUESTED"] },
        "approved_outline_version": { "type": ["string", "null"] },
        "approved_section_assignments_version": { "type": ["string", "null"] },
        "approved_logic_map_version": { "type": ["string", "null"] },
        "writing_started_after_approval": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "audit_report_fields": {
      "type": "object",
      "required": [
        "template_compliance",
        "section_completeness",
        "length_compliance",
        "typography_compliance",
        "markdown_rendering_style",
        "target_route_consistency",
        "citation_authenticity_status",
        "reference_completeness",
        "unresolved_issues",
        "suitable_for_submission"
      ],
      "properties": {
        "template_compliance": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "section_completeness": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "length_compliance": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "typography_compliance": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "markdown_rendering_style": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "target_route_consistency": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "citation_authenticity_status": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "reference_completeness": { "type": "string", "enum": ["pass", "warning", "fail"] },
        "unresolved_issues": { "type": "array", "items": { "type": "string" } },
        "suitable_for_submission": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "change_log": { "type": "array", "items": { "type": "object" } },
    "status": { "type": "string", "enum": ["SUCCESS", "NEED_USER_INPUT", "NEED_REVISION", "BLOCKED", "FAILED"] }
  },
  "additionalProperties": false
}
