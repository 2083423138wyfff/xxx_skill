{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/xxx-skill/schemas/docx_format_profile.schema.json",
  "title": "DocxFormatProfile",
  "type": "object",
  "required": [
    "artifact",
    "source",
    "source_ref",
    "user_approved_builtin_template",
    "page_setup",
    "body_style",
    "heading_styles",
    "toc_style",
    "figure_style",
    "table_style",
    "header_footer_style",
    "numbering_style",
    "unresolved_format_questions",
    "status"
  ],
  "properties": {
    "artifact": { "$ref": "./artifact.schema.json" },
    "source": { "type": "string", "enum": ["user_template", "builtin_template", "manual_user_answers"] },
    "source_ref": { "type": "string" },
    "user_approved_builtin_template": { "type": "boolean" },
    "extracted_at": { "type": "string", "format": "date-time" },
    "page_setup": { "type": "object" },
    "body_style": { "type": "object" },
    "heading_styles": { "type": "object" },
    "toc_style": { "type": "object" },
    "figure_style": { "type": "object" },
    "table_style": { "type": "object" },
    "header_footer_style": { "type": "object" },
    "numbering_style": { "type": "object" },
    "unresolved_format_questions": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["SUCCESS", "NEED_USER_INPUT", "NEED_REVISION", "BLOCKED", "FAILED"] }
  },
  "additionalProperties": false
}
